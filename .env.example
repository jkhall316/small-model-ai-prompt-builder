# Copy to .env and edit. Every variable is optional; commented lines show the defaults.

# Any OpenAI-compatible chat endpoint (ends with /v1 for Ollama, llama.cpp, LM Studio, vLLM, LocalAI, OpenAI).
# Running natively:     http://127.0.0.1:11434/v1
# Running in Docker:    http://host.docker.internal:11434/v1   (127.0.0.1 would be the container itself)
PB_BASE_URL=http://127.0.0.1:11434/v1
PB_MODEL=qwen3:4b
PB_API_KEY=

# Extra JSON merged into every request (must be a JSON object). Use it to switch off "thinking" on hybrid models:
#   Qwen3 / Qwen3.5 on llama.cpp or vLLM:  {"chat_template_kwargs": {"enable_thinking": false}}
#   Ollama (native thinking switch):       {"think": false}
#   Granite 4.x on LocalAI:                {"reasoning_effort": "none"}
#PB_EXTRA_BODY={}

# Ask the server for grammar-constrained JSON (response_format). Set to false if your backend rejects it.
#PB_JSON_MODE=true
#PB_TIMEOUT_S=180
#PB_CHAT_MAX_TOKENS=900
#PB_TIDY_MAX_TOKENS=1500

# Standalone server (native runs only; docker-compose.yml sets these itself).
#PB_HOST=127.0.0.1
#PB_PORT=7810
# Regex of Host headers the server accepts. Default = loopback only, because the API proxies to your model.
#PB_ALLOWED_HOSTS=.*
